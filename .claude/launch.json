{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "neo-dev-server",
            "runtimeExecutable": "node",
            "runtimeArgs": ["./buildScripts/util/fileServer.mjs"],
            "port": 8080,
            "autoPort": true
        },
        {
            "name": "cockpit",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "cockpit"],
            "port": 8080
        },
        {
            "name": "cockpit-live",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "cockpit:live"],
            "port": 8080
        }
    ]
}
