      {"kind": "scroll", "selector": ".neo-calendar-weekcomponent .neo-c-w-scrollcontainer", "x": 1299, "y": 380}
    ],
    "after": [
      {"selector": ".neo-theme-dark .neo-calendar-weekcomponent"},
      {"selector": ".neo-allday-event", "text": "Architecture summit", "inRegion": true},
      {"selector": ".neo-event", "text": "Acme renewal call", "inRegion": true},
      {"selector": ".neo-event", "text": "Design review", "inRegion": true},
      {"selector": ".neo-event", "text": "On-call handover", "inRegion": true}
    ],
    "region": {"selector": ".neo-calendar-weekcomponent", "anchor": "top-left", "width": 640, "height": 360}
  }
]
