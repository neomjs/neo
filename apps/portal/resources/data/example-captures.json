{
  "version": 1,
  "families": ["grid-table", "gantt", "scheduler", "components"],
  "suffix": "14",
  "recipes": [
    {
      "id": "grid-animated-row-sorting",
      "viewport": {"width": 640, "height": 360},
      "theme": "default",
      "state": "Firstname sorted ascending, with the Transition Duration control above the reordered rows.",
      "ready": [{"selector": ".neo-grid-cell[data-field='firstname']", "text": "Max"}],
      "steps": [
        {"kind": "fill", "selector": ".neo-numberfield input", "value": "1000"},
        {"kind": "press", "selector": ".neo-numberfield input", "key": "Tab"},
        {"kind": "click", "selector": ".neo-grid-header-button", "text": "Firstname"}
      ],
      "after": [
        {"selector": "[role='columnheader'][aria-sort='ascending']", "text": "Firstname"},
        {"selector": ".neo-grid-row:first-child .neo-grid-cell[data-field='firstname']", "text": "Amanda"},
        {"selector": ".neo-numberfield", "text": "Transition Duration"}
      ],
      "region": {"x": 0, "y": 0, "width": 640, "height": 360}
    },
    {
      "id": "grid-cell-editing",
      "viewport": {"width": 1280, "height": 720},
      "theme": "dark",
      "state": "A quantity of 60 refused in the order sheet's open editor (at most 50), in the dark grid.",
      "ready": [
        {"selector": ".neo-grid-cell[data-field='quantity']"},
        {"selector": ".neo-configuration-header-toolbar .neo-button", "text": "Theme Dark"}
      ],
      "steps": [
        {"kind": "click", "selector": ".neo-configuration-header-toolbar .neo-button", "text": "Theme Dark"},
        {"kind": "dblclick", "selector": ".neo-grid-cell[data-field='quantity']", "nth": 1},
        {"kind": "fill", "selector": ".neo-grid-editor input", "value": "60"},
        {"kind": "press", "selector": ".neo-grid-editor input", "key": "Enter"}
      ],
      "after": [{"selector": ".neo-grid-editor .neo-textfield-error", "text": "At most 50"}],
      "region": {"selector": ".neo-example-container", "anchor": "top-left", "width": 640, "height": 360}
    },
    {
      "id": "grid-container",
      "viewport": {"width": 1280, "height": 720},
      "theme": "dark",
      "state": "A selected row crosses a selected column in Cell & Column & Row mode.",
      "ready": [{"selector": ".neo-grid-cell[data-field='firstname']"}],
      "steps": [
        {"kind": "click", "selector": ".neo-configuration-header-toolbar .neo-button", "text": "Theme Dark"},
        {"kind": "click", "selector": ".neo-radiofield", "text": "Cell & Column & Row"},
        {"kind": "click", "selector": ".neo-grid-cell[data-field='lastname']", "nth": 1}
      ],
      "after": [
        {"selector": ".neo-grid-row.neo-selected"},
        {"selector": ".neo-grid-cell.selected-column-cell"},
        {"selector": ".neo-grid-cell[aria-selected='true']"}
      ],
      "region": {"selector": ".neo-example-container", "anchor": "top-left", "width": 640, "height": 360}
    },
    {
      "id": "grid-content-sized-rows",
      "viewport": {"width": 1280, "height": 720},
      "theme": "default",
      "state": "Content-sized rows re-enabled after comparison, showing wrapped Summary beside locked # and Title.",
