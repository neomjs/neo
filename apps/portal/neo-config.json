{
    "appPath"                     : "apps/portal/app.mjs",
    "basePath"                    : "../../",
    "corpusBasePath"              : "resources/content/",
    "environment"                 : "development",
    "mainPath"                    : "./Main.mjs",
    "releaseNotesBasePath"        : ".github/RELEASE_NOTES/",
    "remotesApiUrl"               : "remotes-api.json",
    "routerIgnorePaths"           : [
        "^/(?:dist|raw|resources|resources_pub|badges|node_modules|apps)(?:/|$)",
        "^/examples/[^/]+/.+",
        "^/docs/"
    ],
    "themes"                      : ["neo-theme-neo-dark", "neo-theme-neo-light", "neo-theme-light", "neo-theme-dark"],
    "useAiClient"                 : true,
    "useCanvasWorker"             : true,
    "useCanvasWorkerStartingPoint": true,
    "useSharedWorkers"            : true,
    "useServiceWorker"            : "dist/production",

    "mainThreadAddons": [
        "AmCharts",
        "DragDrop",
        "HighlightJS",
        "IntersectionObserver",
        "LocalStorage",
        "MonacoEditor",
        "Navigator",
        "ResizeObserver",
        "Stylesheet",
        "WebComponent"
    ]
}
