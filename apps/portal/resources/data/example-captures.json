      "steps": [{"kind": "click", "selector": ".neo-grid-header-button", "text": "Country"}],
      "after": [{"selector": "[role='columnheader'][aria-sort]", "text": "Country"}, {"selector": ".neo-grid-cell img"}],
      "region": {"x": 20, "y": 20, "width": 640, "height": 360}
    },
    {
      "id": "grid-filtering",
      "viewport": {"width": 640, "height": 360},
