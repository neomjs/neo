{
  "permissions": {
    "allow": [
      "mcp__neo-mjs-github-workflow__*",
      "mcp__neo-mjs-memory-core__*",
      "mcp__neo-mjs-knowledge-base__*",
      "Bash(npm run agent-push*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git checkout -b agent/*)",
      "Bash(git checkout dev)",
      "Bash(git pull origin dev)",
      "Bash(git fetch*)",
      "Bash(git status*)",
      "Bash(git log*)",
      "Bash(git diff*)",
      "Bash(git branch*)",
      "Bash(git rev-list*)",
      "Bash(git rev-parse*)",
      "Bash(git merge-base*)",
      "Bash(git show *)",
      "Bash(git checkout -- *)",
      "Bash(git restore *)",
      "Bash(git rebase *)",
      "Bash(git push --force-with-lease origin *)",
      "Bash(git push --force origin *)",
      "Bash(gh pr create *)",
      "Bash(gh pr view *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr list *)",
      "Bash(gh issue view *)",
      "Bash(gh issue list *)",
      "Bash(docker exec neo-local-agent-os-orchestrator-1 *)",
      "Bash(docker exec -i -w /app neo-local-agent-os-orchestrator-1 *)",
      "Bash(docker exec neo-local-agent-os-mc-server-1 *)",
      "Bash(docker exec neo-local-agent-os-kb-server-1 *)",
      "Bash(docker exec neo-local-agent-os-fleet-server-1 *)"
    ],
    "deny": [
      "Bash(gh pr merge *)",
      "Bash(git push* --force* origin dev*)",
      "Bash(git push* --force* origin main*)",
      "Bash(git push* -f * origin dev*)",
      "Bash(git push* -f * origin main*)",
      "Bash(git push* *:*)",
      "Bash(git push origin dev*)",
      "Bash(git push origin main*)",
      "Bash(git commit* --no-verify*)",
      "Bash(git commit* -n *)",
      "Workflow",
      "mcp__ccd_session__start_session",
      "mcp__ccd_session__hand_off_to_session",
      "mcp__scheduled-tasks__create_scheduled_task",
      "mcp__scheduled-tasks__run_scheduled_task"
    ],
    "ask": []
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.claude/hooks/rgReplaceGuardHook.mjs\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.claude/hooks/bodyFileGuardHook.mjs\"",
            "timeout": 2
          },
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.claude/hooks/redirectionGuardHook.mjs\"",
            "timeout": 2
          }
        ]
      },
      {
        "matcher": "^(Agent|Task)$",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.claude/hooks/helperCallGuardHook.mjs\"",
            "timeout": 5,
            "onFailure": "block"
          }
        ]
      }
    ]
  }
}
