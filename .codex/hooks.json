{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-context.mjs\" --session-start",
            "timeout": 10,
            "statusMessage": "Core preflight"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/env node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-context.mjs\"",
            "timeout": 10,
            "statusMessage": "Loading Codex context"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "NEO_CODEX_LANE_STATE_ENFORCE=1 /usr/bin/env node \"$(git rev-parse --show-toplevel)/.codex/hooks/codex-lane-state-stop.mjs\"",
            "timeout": 10,
            "statusMessage": "Checking Codex lane state"
          }
        ]
      }
    ]
  }
}
