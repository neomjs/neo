      "after": [
        {"selector": ".grid-filtering-toolbar .neo-button", "text": "Light theme"},
        {"selector": ".grid-filtering-count", "text": "405 of 10,000 orders"},
        {"selector": ".neo-grid-cell[data-field='category']", "text": "Lighting"}
