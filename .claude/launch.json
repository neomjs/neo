{
    "version": "0.0.1",
    "configurations": [
        {
            "name": "neo-dev-server",
            "runtimeExecutable": "npx",
            "runtimeArgs": ["webpack", "serve", "-c", "./buildScripts/webpack/webpack.server.config.mjs"],
            "port": 8080,
            "autoPort": true
        },
        {
            "name": "cockpit",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "cockpit"],
            "port": 8080
        },
        {
            "name": "cockpit-live",
            "runtimeExecutable": "npm",
            "runtimeArgs": ["run", "cockpit:live"],
            "port": 8080
        }
    ]
}
