      "dependencies": ["https://hatscripts.github.io/circle-flags/flags/in.svg"],
      "ready": [{"selector": ".neo-grid-cell[data-field='country']", "text": "India"}],
      "steps": [{"kind": "click", "selector": ".neo-grid-cell[data-field='population']", "nth": 1}],
